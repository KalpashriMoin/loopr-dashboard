{
  "info": {
    "name": "Loopr Financial Analytics Dashboard API",
    "description": "Full API collection for the Loopr full-stack assignment. Run 'Login' first — it automatically saves the JWT into the {{token}} variable for every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Analyst\",\n  \"email\": \"jane@loopr.dev\",\n  \"password\": \"SecurePass1\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    console.log('Saved token to {{token}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@loopr.dev\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "List Transactions (paginated/filtered/sorted)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/transactions?page=1&limit=10&sortBy=date&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "date" },
                { "key": "sortOrder", "value": "desc" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "category", "value": "Revenue", "disabled": true },
                { "key": "status", "value": "Paid", "disabled": true },
                { "key": "user_id", "value": "user_001", "disabled": true },
                { "key": "dateFrom", "value": "2024-01-01", "disabled": true },
                { "key": "dateTo", "value": "2024-06-30", "disabled": true },
                { "key": "amountMin", "value": "100", "disabled": true },
                { "key": "amountMax", "value": "5000", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Filter Options",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/transactions/filters", "host": ["{{baseUrl}}"], "path": ["transactions", "filters"] }
          }
        },
        {
          "name": "Get Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/transactions/summary", "host": ["{{baseUrl}}"], "path": ["transactions", "summary"] }
          }
        }
      ]
    },
    {
      "name": "Export",
      "item": [
        {
          "name": "Get Export Columns",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/export/columns", "host": ["{{baseUrl}}"], "path": ["export", "columns"] }
          }
        },
        {
          "name": "Export CSV",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columns\": [\"date\", \"user_id\", \"category\", \"status\", \"amount\"],\n  \"filters\": {\n    \"category\": \"Revenue\",\n    \"status\": \"Paid\"\n  },\n  \"fileName\": \"revenue_paid_export\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/export/csv", "host": ["{{baseUrl}}"], "path": ["export", "csv"] }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    }
  ]
}
